{
  "name": "workshop-desktop",
  "version": "0.1.14",
  "private": true,
  "description": "A lightweight cross-platform desktop client for Workshop todos.",
  "author": "Workshop",
  "main": "dist/main/main.js",
  "packageManager": "pnpm@11.5.2",
  "scripts": {
    "dev": "pnpm run build:main && concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env ELECTRON_RENDERER_URL=http://127.0.0.1:5173 electron dist/main/main.js\"",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "build": "pnpm run build:main && pnpm run build:renderer",
    "preview": "vite preview --host 127.0.0.1",
    "start": "pnpm run build && electron dist/main/main.js",
    "test:main": "pnpm run build:main && node --test scripts/main-architecture-smoke.test.mjs",
    "pack": "pnpm run build && electron-builder --dir",
    "dist": "pnpm run build && electron-builder",
    "package:build": "bash scripts/package.sh build",
    "package:dir": "bash scripts/package.sh dir",
    "package:dist": "bash scripts/package.sh dist",
    "release": "bash scripts/release.sh",
    "check:precommit": "bash scripts/pre-commit-check.sh",
    "app:cli": "node scripts/workshop-desktop-cli.mjs",
    "app:record:create": "node scripts/workshop-desktop-cli.mjs record create",
    "app:record:list": "node scripts/workshop-desktop-cli.mjs record list",
    "app:record:get": "node scripts/workshop-desktop-cli.mjs record get",
    "app:project:list": "node scripts/workshop-desktop-cli.mjs project list",
    "app:task:list": "node scripts/workshop-desktop-cli.mjs task list",
    "app:task:get": "node scripts/workshop-desktop-cli.mjs task get"
  },
  "dependencies": {
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "lucide-react": "^0.561.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^39.2.7",
    "electron-builder": "26.8.1",
    "playwright": "^1.60.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.7",
    "wait-on": "^9.0.3"
  },
  "build": {
    "appId": "com.workshop.todo.tray",
    "productName": "Workshop Todo",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/app-icon.png",
        "to": "app-icon.png"
      },
      {
        "from": "resources/tray-icon.png",
        "to": "tray-icon.png"
      },
      {
        "from": "resources/tray-iconTemplate.png",
        "to": "tray-iconTemplate.png"
      },
      {
        "from": "resources/tray-iconTemplate@2x.png",
        "to": "tray-iconTemplate@2x.png"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "hoewo",
        "repo": "workshop-desktop",
        "releaseType": "release"
      }
    ],
    "mac": {
      "icon": "resources/app-icon.icns",
      "artifactName": "Workshop.Todo-${version}-${arch}-${os}.${ext}",
      "target": [
        "zip"
      ],
      "hardenedRuntime": true,
      "notarize": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "category": "public.app-category.productivity"
    },
    "win": {
      "icon": "resources/app-icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "icon": "resources/app-icon.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility"
    }
  }
}
